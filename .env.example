# Copy this file to .env and fill in your own key (.env is never committed).
# The key: https://addons.mozilla.org/developers/addon/api/key/

# "JWT issuer"
AMO_API_KEY=user:<numer>:<numer>
# "JWT secret"
AMO_API_SECRET=

# Optional: how long `node sign.mjs` waits for Mozilla to sign, in milliseconds (default: an hour).
# 0 = only upload; then download the .xpi from the Developer Hub.
# AMO_APPROVAL_TIMEOUT=3600000
